{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OPSI Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostId": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "externalUrl": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$"
        },
        "configServiceUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$"
          }
        },
        "ipAddress": {
          "type": "string",
          "format": "ipv4",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "depotRemoteUrl": {
          "type": "string",
          "pattern": "^webdavs://[A-Za-z0-9.-]+(:[0-9]+)?/[^\\s]*$"
        },
        "depotWebdavUrl": {
          "type": "string",
          "pattern": "^webdavs://[A-Za-z0-9.-]+(:[0-9]+)?/[^\\s]*$"
        },
        "repositoryRemoteUrl": {
          "type": "string",
          "pattern": "^webdavs://[A-Za-z0-9.-]+(:[0-9]+)?/[^\\s]*$"
        },
        "workbenchRemoteUrl": {
          "type": "string",
          "pattern": "^webdavs://[A-Za-z0-9.-]+(:[0-9]+)?/[^\\s]*$"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "hostId",
        "externalUrl",
        "configServiceUrls",
        "ipAddress",
        "depotRemoteUrl",
        "depotWebdavUrl",
        "repositoryRemoteUrl",
        "workbenchRemoteUrl",
        "trustedProxies",
        "timezone",
        "logLevel"
      ]
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "const": "adminuser"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "username",
        "existingSecret",
        "passwordKey"
      ]
    },
    "mysql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "host",
        "port",
        "database",
        "username",
        "existingSecret",
        "passwordKey"
      ]
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "port": {
          "const": 6379
        },
        "database": {
          "type": "integer",
          "minimum": 0
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "host",
        "port",
        "database",
        "existingSecret",
        "passwordKey"
      ]
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany"
            ]
          }
        },
        "keep": {
          "type": "boolean"
        }
      },
      "required": [
        "existingClaim",
        "size",
        "storageClass",
        "accessModes",
        "keep"
      ]
    },
    "pxe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostNetwork": {
          "type": "boolean"
        },
        "tftpPersistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany"
                ]
              }
            },
            "keep": {
              "type": "boolean"
            }
          },
          "required": [
            "existingClaim",
            "size",
            "storageClass",
            "accessModes",
            "keep"
          ]
        }
      },
      "required": [
        "enabled",
        "hostNetwork",
        "tftpPersistence"
      ]
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        }
      },
      "required": [
        "enabled",
        "timeoutSeconds"
      ]
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "additionalCAs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "-----BEGIN CERTIFICATE-----"
          }
        },
        "existingCAConfigMap": {
          "type": "string"
        }
      },
      "required": [
        "additionalCAs",
        "existingCAConfigMap"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "port",
        "annotations"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "create",
        "name",
        "annotations"
      ]
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        }
      },
      "required": [
        "startup",
        "liveness",
        "readiness"
      ]
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "configKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "suspend",
        "schedule",
        "existingSecret",
        "configKey",
        "resources"
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "global": {
      "type": "object"
    }
  },
  "required": [
    "replicaCount",
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "server",
    "admin",
    "mysql",
    "redis",
    "persistence",
    "pxe",
    "bootstrap",
    "tls",
    "service",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "resources",
    "terminationGracePeriodSeconds",
    "probes",
    "nodeSelector",
    "tolerations",
    "affinity",
    "connector",
    "tests"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "pxe": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "pxe": {
            "properties": {
              "hostNetwork": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "connector": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "connector": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
